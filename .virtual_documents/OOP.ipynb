user_account.append(ud1)


user_account.append(ud2)


user_account


for acc in user_account:
    acc.print_details()
    print('\n')


def log(email,pwd):
    for acc in user_account:
        if email== acc.email and pwd== acc.password:
            print('Login Success')
            return
    return 'Incorrect email or password'


