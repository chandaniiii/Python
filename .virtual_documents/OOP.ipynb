class product_details:
    def __init__(self,Product_Name,Product_Quantity,Product_Price,Product_Category,Product_Brand):
        self.Product_Name = Product_Name
        self.Product_Quantity = Product_Quantity
        self.Product_Price = Product_Price
        self.Product_Category = Product_Category
        self.Product_Brand = Product_Brand
    
    def products(self):
        print(f'{self.Product_Name}')
        print(f'{self.Product_Quantity}')
        print(f'{self.Product_Price}')
        print(f'{self.Product_Category})
        print(f'{self.Product_Category})


p = product_details('Laptop',23,'$4560','Electric','Macbook')


p2 = product_details('TV',43,'$4500','Mechanic','Samsung')


all_products = []


all_products.append(p)


all_products.append(p2)


def search_product(Product_Name):
    for name in all_products:
        if Product_Name == name.Product_Name :
            print(f'Product Name : {Product_Name}')
            return
    return 'No product found'


search_product('Laptop')


