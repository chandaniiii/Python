from abc import ABC, abstractmethod


class MobileBanking(ABC):
    @abstractmethod
    def userDetails(self):
        pass


class NabilMobileBanking(MobileBanking):
    
    def Connection(self):
        print('Connected to Nabil Bank Database Server..')

    def userDetails(self):
        print(f'A/C No : 12345678\nBalance: Rs60987654')


nb = NabilMobileBanking()


nb.Connection()


nb.userDetails()


