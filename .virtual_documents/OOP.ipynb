def searchOrderbyCustomer(customer_name):
    for order in order_details:
        if order.customer_name == customer_name:
            return order.order_details()
    else:
        return f'No order found with customer name {customer_name}'


searchOrderbyCustomer('Chandani')


def searchOrderbyCustomer(customer_name):
    customer_orders =[]
    for order in order_details:
        if order.customer_name == customer_name:
            customer_orders.append(order.order_details())

    if customer_orders:
        return customer_orders
    else:
        return f'No order found with customer name {customer_name}'


searchOrderbyCustomer('Sam')


class Order_items(Orders):
    def __init__(self,item_id,item_price,item_quantity,item_discount,
                order_id,order_status,order_date,order_destination,customer_id,
                 customer_name,customer_address,customer_phone):
        super().__init__(order_id,order_status,order_date,order_destination,
                         customer_id,customer_name,customer_address,customer_phone)
        self.item_id = item_id
        self.item_price = item_price
        self.item_quantity = item_quantity
        self.item_discount = item_discount

    def display_items(self):
        print(f'Item ID:{self.item_id}')
        print(f'Item Price:{self.item_price}')
        print(f'Item Quantity:{self.item_quantity}')
        print(f'Item Discount:{self.item_discount}')


