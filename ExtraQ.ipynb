   "source": [
    "import re\n",
    "\n",
    "def validatePassword(password):\n",
    "    pattern = r'^[a-zA-Z].{6}#$'\n",
    "    validate = bool(re.match(pattern,password))\n",
    "    return 'Pattern Matched' if validate else 'Unmatched Pattern'\n",
    "    "
   ]
  },
